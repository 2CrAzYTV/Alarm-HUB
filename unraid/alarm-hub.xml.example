<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>Alarm-HUB</Name>
  <Repository>ghcr.io/2crazytv/alarm-hub:latest</Repository>
  <Registry>https://ghcr.io/2crazytv/alarm-hub</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/2CrAzYTV/Alarm-HUB/issues</Support>
  <Project>https://github.com/2CrAzYTV/Alarm-HUB</Project>
  <Overview>Alarm-HUB ist ein eigenständiger Multi-User-Weckerdienst mit manuellen Weckern, API-Zugriff für mobile Automationen sowie optionaler WebComm-Integration, direktem WebComm-Import und optionaler Fahrzeitberechnung. Für normale Installationen ist PostgreSQL bereits integriert. Es wird kein zweiter Datenbank-Container benötigt; Datenbank und automatisch erzeugter Secret Key bleiben persistent unter /config erhalten. Externes PostgreSQL bleibt als Advanced-Option verfügbar.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://github.com/2CrAzYTV/Alarm-HUB/raw/refs/heads/main/icon.png</Icon>
  <TemplateURL>https://raw.githubusercontent.com/2CrAzYTV/Alarm-HUB/main/templates/alarm-hub.xml</TemplateURL>
  <ReadMe>https://raw.githubusercontent.com/2CrAzYTV/Alarm-HUB/main/README.md</ReadMe>
  <ExtraSearchTerms>alarm alarms wecker webcomm schedule shortcut ios automation commute routing</ExtraSearchTerms>
  <License>MIT</License>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>Standardinstallation: keine separate PostgreSQL-Installation und kein .env erforderlich. Für öffentlichen Internetzugriff einen Reverse Proxy mit gültigem HTTPS-Zertifikat verwenden und Secure Session Cookies aktivieren. Fahrzeitberechnung ist optional.</Requires>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Port der Alarm-HUB WebUI" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/alarm-hub" Mode="rw" Description="Persistente Alarm-HUB-Daten inklusive eingebetteter PostgreSQL-Datenbank und automatisch erzeugtem Secret Key" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/alarm-hub</Config>
  <Config Name="Database Mode" Target="DATABASE_MODE" Default="embedded" Mode="" Description="embedded = integrierte PostgreSQL-Datenbank (Standard); external = eigene PostgreSQL-Datenbank verwenden" Type="Variable" Display="advanced" Required="true" Mask="false">embedded</Config>
  <Config Name="External Database URL" Target="DATABASE_URL" Default="" Mode="" Description="Optional. Nur bei DATABASE_MODE=external erforderlich. Beispiel: postgresql+psycopg://user:password@host:5432/database" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Secret Key" Target="SECRET_KEY" Default="" Mode="" Description="Optional. Im Embedded-Modus erzeugt Alarm-HUB automatisch einen persistenten Secret Key unter /config. Für externe oder verwaltete Installationen kann ein eigener fester Schlüssel verwendet werden." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Default Timezone" Target="DEFAULT_TIMEZONE" Default="Europe/Berlin" Mode="" Description="Standard-Zeitzone für neue Benutzer" Type="Variable" Display="advanced" Required="true" Mask="false">Europe/Berlin</Config>
  <Config Name="Secure Session Cookies" Target="SESSION_HTTPS_ONLY" Default="false" Mode="" Description="Standard false für direkten lokalen HTTP-Zugriff in Unraid. Bei Betrieb hinter einem HTTPS-Reverse-Proxy auf true setzen." Type="Variable" Display="advanced" Required="true" Mask="false">false</Config>
  <Config Name="Public Base URL" Target="PUBLIC_BASE_URL" Default="" Mode="" Description="Optional. Öffentliche Adresse dieser Instanz, z. B. https://alarm.example.com. Die Anleitungen zeigen die API-Adressen damit an, auch wenn die Seite über die lokale IP geöffnet wird. Leer = die Adresse, über die die Seite geöffnet wurde." Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="OpenRouteService API Key" Target="OPENROUTESERVICE_API_KEY" Default="" Mode="" Description="Optional. Nur für Fahrzeitberechnung per Auto/Fahrrad und Adressauflösung erforderlich. Bus/Bahn verwendet Transitous und benötigt keinen eigenen API-Key." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Admin E-Mails" Target="ADMIN_EMAILS" Default="" Mode="" Description="Optional. Kommagetrennte E-Mail-Adressen der Konten, die /admin öffnen dürfen (Konten ansehen, bearbeiten, sperren, löschen, Registrierungsmodus ändern). Leer = keine Admin-Seite." Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Registration Mode" Target="REGISTRATION_MODE" Default="open" Mode="" Description="open = jeder kann sich registrieren, invite = Registrierung nur mit Einladungscode, closed = keine neuen Konten. Für öffentlich erreichbare Instanzen invite oder closed verwenden. Lässt sich auf der Admin-Seite zur Laufzeit ändern." Type="Variable" Display="advanced" Required="false" Mask="false">open</Config>
  <Config Name="Registration Invite Code" Target="REGISTRATION_INVITE_CODE" Default="" Mode="" Description="Pflicht bei Registration Mode invite. Nur an Personen weitergeben, die ein Konto bekommen sollen." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Login Max Failures" Target="LOGIN_MAX_FAILURES" Default="5" Mode="" Description="Fehlgeschlagene Logins pro IP bis zur vorübergehenden Sperre (pro Konto das Doppelte)." Type="Variable" Display="advanced" Required="false" Mask="false">5</Config>
  <Config Name="Login Lockout Seconds" Target="LOGIN_LOCKOUT_SECONDS" Default="900" Mode="" Description="Dauer der Login-Sperre in Sekunden." Type="Variable" Display="advanced" Required="false" Mask="false">900</Config>
</Container>
